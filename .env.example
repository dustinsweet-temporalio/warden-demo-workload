# Connection to the OBSERVED namespace this workload runs in.
# This is the namespace Warden watches. Copy to .env and fill in.
#
# Address form: <namespace>.<account>.tmprl.cloud:7233
# Namespace form (full id): <namespace>.<account>
TEMPORAL_ADDRESS=your-namespace.your-account.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace.your-account
TEMPORAL_API_KEY=your-api-key

# Dashboard (operator surface) bind address.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8800

# Generator tuning. Baseline APS lands ~11-13 with these defaults.
# ~0.6 orders/sec * ~14 actions/run => ~8.4 APS from orders.
ORDER_START_RATE_PER_SEC=0.6
ORDER_START_JITTER=0.2

# Whether orders upsert OrderStage as the saga advances (3 billable actions per
# order, plus 1 for the settlement payout). This is what makes the visibility
# demo show live stage progression. Set to false, or drop the order rate to 0.45,
# for the original 8-10 APS baseline; start-time search attributes are free and
# stay either way.
ORDER_STAGE_TRACKING=true

# How many entity workflows to keep alive at baseline.
COURIER_FLEET_SIZE=10

# How often the in-process control cache refreshes from demo-control (seconds).
CONTROL_CACHE_REFRESH_SEC=2.5
